@{
    ViewData["Title"] = "Регистрация";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="text-center mb-4">Регистрация</h2>

                <form asp-action="Register" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label">Имя пользователя (Логин)</label>
                        <input name="userName" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input name="email" type="email" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Пароль</label>
                        <input name="password" type="password" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Дата рождения</label>
                        <input name="birthDate" type="date" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Аватар</label>
                        <input name="avatar" type="file" class="form-control" accept="image/*" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Зарегистрироваться</button>
                </form>
            </div>
        </div>
    </div>
</div>